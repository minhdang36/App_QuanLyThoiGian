<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="#EEF0F4"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER ROW: PHASE NAME & PRIORITY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbSelectTask"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:checked="true"
                android:buttonTint="#10B981" />

            <TextView
                android:id="@+id/tvWbsPhase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Giai đoạn 1: Lập kế hoạch &amp; Nghiên cứu"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWbsPriority"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/bg_pill_brown"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="High"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TASK TITLE -->
        <TextView
            android:id="@+id/tvWbsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Lập danh sách yêu cầu hệ thống &amp; tài liệu thiết kế"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- DESCRIPTION & DEFINITION OF DONE -->
        <TextView
            android:id="@+id/tvWbsDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mô tả: Liệt kê đầy đủ 10 tính năng cốt lõi. Definition of Done: Được xác nhận bởi Product Owner."
            android:textColor="#666666"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="#F0F0F0" />

        <!-- FOOTER INFO: DATE, ESTIMATED HOURS, POMODORO COUNT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWbsDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📅 2026-10-18"
                android:textColor="#362C2A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWbsHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ 2.0 giờ  •  🍅 4 Pomodoro"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>