<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="#EEF0F4"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Checkbox / Status dot indicator -->
        <CheckBox
            android:id="@+id/cbTaskStatus"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:buttonTint="#362C2A"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="Hoàn thiện báo cáo chiến lược Q1"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/layoutItemActions"
            app:layout_constraintStart_toEndOf="@id/cbTaskStatus"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Time and Priority subtitle -->
        <TextView
            android:id="@+id/tvTaskTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:text="🕒 Hôm nay, 16:30 • Ưu tiên cao"
            android:textColor="#888888"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/layoutItemActions"
            app:layout_constraintStart_toEndOf="@id/cbTaskStatus"
            app:layout_constraintTop_toBottomOf="@id/tvTaskTitle" />

        <!-- Category tag pill -->
        <TextView
            android:id="@+id/tvCategoryPill"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_light"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="🏷 Q1 Strategy"
            android:textColor="#555555"
            android:textSize="11sp"
            app:layout_constraintStart_toEndOf="@id/cbTaskStatus"
            app:layout_constraintTop_toBottomOf="@id/tvTaskTime" />

        <!-- Description (Hidden or brief) -->
        <TextView
            android:id="@+id/tvTaskDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTaskLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <View
            android:id="@+id/viewPriorityColor"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <!-- Actions: Edit & Delete -->
        <LinearLayout
            android:id="@+id/layoutItemActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnEditTask"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#888888" />

            <ImageButton
                android:id="@+id/btnDeleteTask"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#E53935" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>