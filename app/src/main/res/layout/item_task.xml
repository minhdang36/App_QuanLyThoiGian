<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTaskItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/brand_primary"
    app:strokeWidth="1.2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Dải màu nhấn bên trái (Chuẩn Figma MeetEase Scheduler) -->
        <View
            android:id="@+id/viewCategoryAccent"
            android:layout_width="5dp"
            android:layout_height="0dp"
            android:background="@color/brand_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/viewCategoryAccent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 1. Hàng trên: Icon Khối 3D + Giờ (11:30 AM - 12:30 PM) -->
            <ImageView
                android:id="@+id/imgCategoryIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_cube_3d"
                app:layout_constraintBottom_toBottomOf="@id/tvTaskTime"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvTaskTime" />

            <TextView
                android:id="@+id/tvTaskTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="11:30 AM - 12:30 PM"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/cbTaskStatus"
                app:layout_constraintStart_toEndOf="@id/imgCategoryIcon"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Checkbox nhỏ gọn góc trên phải -->
            <CheckBox
                android:id="@+id/cbTaskStatus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:buttonTint="@color/brand_primary"
                app:layout_constraintBottom_toBottomOf="@id/tvTaskTime"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvTaskTime" />

            <!-- 2. Tiêu đề Công việc (Sales Presentation) -->
            <TextView
                android:id="@+id/tvTaskTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:text="Sales Presentation"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/btnEditTask"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTaskTime" />

            <!-- Nút 3 chấm dọc (⋮) bên phải chuẩn Figma MeetEase -->
            <ImageButton
                android:id="@+id/btnEditTask"
                android:layout_width="28dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tùy chọn công việc"
                android:src="@drawable/ic_more_vert_dots"
                app:layout_constraintBottom_toBottomOf="@id/tvTaskDesc"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvTaskTitle" />

            <!-- Nút xóa ẩn để giữ tương thích ID và mở qua menu 3 chấm -->
            <ImageButton
                android:id="@+id/btnDeleteTask"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 3. Mô tả chi tiết (2 dòng chữ xám nhẹ) -->
            <TextView
                android:id="@+id/tvTaskDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="A sales presentation with a potential client. The meeting is set to take place in London..."
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp"
                app:layout_constraintEnd_toStartOf="@id/btnEditTask"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTaskTitle" />

            <!-- 4. Hàng dưới: Icon Địa điểm + Tên Địa điểm + Tag dự án -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTaskDesc">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_location_pin" />

                <TextView
                    android:id="@+id/tvTaskLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="London, UK"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCategoryPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏷 Dự án"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
