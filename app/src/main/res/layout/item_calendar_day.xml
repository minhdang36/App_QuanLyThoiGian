<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <!-- Capsule chứa Thứ & Ngày (Chuẩn Figma MeetEase Scheduler) -->
    <LinearLayout
        android:id="@+id/layoutDay"
        android:layout_width="48dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_day_capsule_unselected"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDayOfWeek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thu"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDateNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="07"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bộ 3 chấm màu báo hiệu sự kiện bên dưới Capsule -->
    <LinearLayout
        android:id="@+id/viewEventDot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="invisible">

        <View
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_circle_teal"
            android:backgroundTint="#2563EB" />

        <View
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_circle_teal"
            android:backgroundTint="#38BDF8" />

        <View
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_circle_teal"
            android:backgroundTint="#F59E0B" />
    </LinearLayout>

</LinearLayout>
