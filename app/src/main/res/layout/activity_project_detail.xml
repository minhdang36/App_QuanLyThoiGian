<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F8"> <!-- Màu nền xám nhạt -->

    <!-- Thanh Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#333333" />

        <!-- Tag Trạng thái -->
        <TextView
            android:id="@+id/tvTaskDetailStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_rounded_24dp"
            android:backgroundTint="#E8F5E9"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="● Đang xử lý"
            android:textColor="#2E7D32"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Cụm Icon góc phải -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@android:drawable/btn_star_big_on"
            app:tint="#FFA000" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@android:drawable/ic_menu_share"
            app:tint="#888888" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#888888" />
    </LinearLayout>

    <!-- Khu vực cuộn chứa nội dung chính -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CARD 1: TIÊU ĐỀ & MÔ TẢ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Tags -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvProjectTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_24dp"
                            android:backgroundTint="#FDECE8"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="• Công việc"
                            android:textColor="#D84315"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPriorityTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_rounded_24dp"
                            android:backgroundTint="#FDECE8"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="! ƯU TIÊN CAO"
                            android:textColor="#D84315"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTaskDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Chưa có tiêu đề"
                        android:textColor="#111111"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTaskDetailDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:text="Không có mô tả chi tiết."
                        android:textColor="#666666"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 2: LỊCH HỌP (Màu xanh đậm) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#004D40"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Icon Đồng hồ nền xanh nhạt -->
                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_brown"
                            android:backgroundTint="#00695C">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_recent_history"
                                app:tint="#80CBC4" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏱ CHẾ ĐỘ TẬP TRUNG • Pomodoro Focus"
                                android:textColor="#80CBC4"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <!-- Thời gian -->
                            <TextView
                                android:id="@+id/tvTaskDetailTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Chưa hẹn giờ"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Địa điểm / Mục tiêu -->
                    <TextView
                        android:id="@+id/tvTaskDetailLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="🎯 Mục tiêu: 25 phút/phiên • Giữ tập trung tối đa"
                        android:textColor="#A7FFEB"
                        android:textSize="12sp" />

                    <!-- Nút Bắt đầu bấm giờ Pomodoro -->
                    <TextView
                        android:id="@+id/btnStartPomodoro"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_rounded_24dp"
                        android:backgroundTint="#64FFDA"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="▶ Bắt đầu bấm giờ làm task"
                        android:textColor="#004D40"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 3: NHIỆM VỤ PHỤ & TIẾN ĐỘ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            app:tint="#333333" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Nhiệm vụ phụ &amp;\nTiến độ"
                            android:textColor="#111111"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- CONTAINER CHỨA CÁC NHIỆM VỤ PHỤ (SUBTASKS / CHECKLIST) -->
                    <LinearLayout
                        android:id="@+id/layoutSubtasksContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />

                    <!-- Nút Thêm Subtask -->
                    <TextView
                        android:id="@+id/btnAddSubtask"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_rounded_24dp"
                        android:backgroundTint="#F4F5F8"
                        android:gravity="center"
                        android:text="⊕ Thêm nhiệm vụ phụ"
                        android:textColor="#004D40"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CỤM NÚT CHỨC NĂNG: HOÀN THÀNH, SỬA, XÓA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Nút Xóa (Đỏ) -->
                <TextView
                    android:id="@+id/btnDeleteTask"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_rounded_24dp"
                    android:backgroundTint="#FFEBEE"
                    android:gravity="center"
                    android:text="Xóa"
                    android:textColor="#C62828"
                    android:textStyle="bold" />

                <!-- Nút Sửa (Vàng/Cam) -->
                <TextView
                    android:id="@+id/btnEditTask"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_rounded_24dp"
                    android:backgroundTint="#FFF3E0"
                    android:gravity="center"
                    android:text="Sửa"
                    android:textColor="#E65100"
                    android:textStyle="bold" />

                <!-- Nút Hoàn thành (Xanh) -->
                <TextView
                    android:id="@+id/btnCompleteTask"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_rounded_24dp"
                    android:backgroundTint="#E8F5E9"
                    android:gravity="center"
                    android:text="Xong ✔"
                    android:textColor="#2E7D32"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>