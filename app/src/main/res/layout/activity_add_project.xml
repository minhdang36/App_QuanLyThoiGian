<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_light"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:text="✨ KHÔNG GIAN DỰ ÁN"
        android:textColor="@color/brand_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tạo Dự Án Lớn Mới"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etProjectName"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_search_bar"
        android:paddingHorizontal="18dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:hint="Tên dự án lớn (VD: Đồ án tốt nghiệp, Ra mắt sản phẩm...)"
        android:inputType="text|textNoSuggestions"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etProjectDesc"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_search_bar"
        android:paddingHorizontal="18dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:hint="Mô tả mục tiêu chính của dự án..."
        android:inputType="text|textNoSuggestions"
        android:textSize="14sp"
        android:layout_marginBottom="20dp"/>

    <!-- CHỨC NĂNG DỰ ÁN LỚN: PHÂN RÃ CÔNG VIỆC AI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_day_capsule_selected"
        android:orientation="vertical"
        android:padding="18dp"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ Dự án lớn (Kích hoạt AI Phân Rã)"
                android:textColor="@color/brand_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchLargeProject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="FlowAI sẽ tự động chia nhỏ dự án lớn thành các giai đoạn và đầu việc thực thi cụ thể."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnSaveProject"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_pill_brown"
        android:gravity="center"
        android:text="✔ TẠO DỰ ÁN LỚN"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"/>
</LinearLayout>
