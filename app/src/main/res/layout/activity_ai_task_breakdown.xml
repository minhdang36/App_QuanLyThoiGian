<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFC"
    tools:context=".ui.ai.AiTaskBreakdownActivity">

    <!-- 1. HEADER BAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_light"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#333333"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phân Rã Dự Án AI"
            android:textColor="#222222"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgAvatar"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_teal"
            android:padding="2dp"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollBreakdown"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="20dp"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toTopOf="@id/bottomActionsLayout"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- INPUT CARD: DỰ ÁN LỚN & THÔNG TIN DỰ ÁN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#EEF0F4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚀 THÔNG TIN DỰ ÁN LỚN"
                        android:textColor="#362C2A"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- TÊN DỰ ÁN -->
                    <EditText
                        android:id="@+id/edtProjectName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_search_bar"
                        android:hint="Tên dự án lớn (VD: Đồ án tốt nghiệp Mobile App)"
                        android:inputType="text"
                        android:paddingHorizontal="14dp"
                        android:textColor="#222222"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- MỤC TIÊU & MÔ TẢ -->
                    <EditText
                        android:id="@+id/edtProjectGoal"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_search_bar"
                        android:gravity="top"
                        android:hint="Mục tiêu &amp; Yêu cầu (VD: Đạt 10 tính năng cốt lõi &amp; báo cáo đồ án)"
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textColor="#333333"
                        android:textSize="13sp" />

                    <!-- DÒNG THỜI GIAN: NGÀY BẮT ĐẦU & KẾT THÚC -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edtStartDate"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_search_bar"
                            android:hint="Bắt đầu: YYYY-MM-DD"
                            android:inputType="date"
                            android:paddingHorizontal="10dp"
                            android:textColor="#222222"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/edtEndDate"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_search_bar"
                            android:hint="Hạn chót: YYYY-MM-DD"
                            android:inputType="date"
                            android:paddingHorizontal="10dp"
                            android:textColor="#222222"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- NÚT GỌI GEMINI AI PHÂN RÃ DỰ ÁN -->
                    <Button
                        android:id="@+id/btnGenerateWbs"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:backgroundTint="#10B981"
                        android:text="⚡ Phân Rã Bằng Gemini AI"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="24dp" />

                    <TextView
                        android:id="@+id/tvConfigureApiKey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:padding="6dp"
                        android:text="🔑 Cấu hình / Đổi Gemini API Key"
                        android:textColor="#10B981"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- RESULT SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Các Giai Đoạn &amp; Công Việc"
                    android:textColor="#222222"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWbsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_pill_light"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="● 0 Công việc"
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- RECYCLERVIEW HIỂN THỊ DANH SÁCH CÔNG VIỆC PHÂN RÃ -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWbsTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM ACTION BUTTONS: ĐỒNG BỘ / LƯU VÀO DỰ ÁN -->
    <LinearLayout
        android:id="@+id/bottomActionsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnApplyBreakdown"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#362C2A"
            android:text="✔ Đồng bộ / Lưu vào Dự án"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="26dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>