<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal">

    <!-- Thời gian bên trái (VD: 07:00 \n 09:30) -->
    <TextView
        android:id="@+id/tvTimelineTime"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:text="08:30\n09:30"
        android:textColor="#888888"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Thẻ nội dung công việc / lịch học -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="#EEF0F4"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTimelineTagAi"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_pill_brown"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="⚡ AI Xếp lịch"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTimelineTagCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_light"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="🏷 Học tập"
                    android:textColor="#555555"
                    android:textSize="10sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvTimelineDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60 phút"
                    android:textColor="#888888"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTimelineTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Thực hành Lập trình di động"
                android:textColor="#222222"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimelineDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Phòng máy tính 13/H • GV: Trần Thị Huệ"
                android:textColor="#777777"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTimelineSubInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📍 PMT 13/H"
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbTimelineStatus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:buttonTint="#10B981" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>